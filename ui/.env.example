# The deployed preview and a default local checkout use the deterministic simulator.
MOLOR_CHAT_BACKEND=simulator

# To bridge an explicitly started, authenticated local model runtime, change the
# backend to "local" and provide the exact loopback endpoint plus a random token.
# MOLOR_CHAT_BACKEND=local
# MOLOR_RUNTIME_URL=http://127.0.0.1:8765/v1/chat/stream
# MOLOR_RUNTIME_TOKEN=replace-with-at-least-32-random-url-safe-characters

# `npm run local` serves the built UI on loopback. PORT defaults to 3000.
# PORT=3000

# Optional timeout overrides in milliseconds.
# MOLOR_RUNTIME_CONNECT_TIMEOUT_MS=3000
# MOLOR_RUNTIME_FIRST_EVENT_TIMEOUT_MS=10000
# MOLOR_RUNTIME_IDLE_TIMEOUT_MS=120000
# MOLOR_RUNTIME_TOTAL_TIMEOUT_MS=21600000
