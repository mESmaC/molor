{
  "model_id": "../../models/Qwen3-0.6B",
  "output_dir": "../../checkpoints/qwen3-0.6b-corpus-experts",
  "dtype": "bfloat16",
  "device": "cuda",
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "rank": 16,
  "alpha": 32,
  "dropout": 0.05,
  "max_length": 1024,
  "epochs": 1,
  "learning_rate": 0.00005,
  "lr_scheduler": "cosine",
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "micro_batch_size": 3,
  "gradient_accumulation_steps": 3,
  "gradient_checkpointing": true,
  "autocast_adapter_compute": true,
  "batching_strategy": "pretokenized_group_sorted",
  "fused_adamw": false,
  "checkpoint_every_steps": 250,
  "max_grad_norm": 1.0,
  "seed": 101,
  "chat_template_kwargs": {
    "enable_thinking": true
  },
  "experts": [
    {
      "name": "reasoning-trace-v1",
      "dataset": "../../datasets/reasoning-trace-v1/train.jsonl"
    }
  ]
}
